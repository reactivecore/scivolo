scala> def foo: (a: Int, b: String) = (a = 42, b = "Hello")
def foo: (a : Int, b : String)

scala> foo
val res0: (a : Int, b : String) = (42, "Hello")

scala> foo.b
val res1: String = "Hello"

scala> val p = (name = "Bob", age = 33)
val p: (name : String, age : Int) = ("Bob", 33)

scala> p.age + 1
val res2: Int = 34
