scala> class A(var p: Int)
-- unsupported: mutable class parameters

scala> def f() = { lazy val x = 1; x }
-- unsupported: local lazy values

scala> val y = 2
val y: Int = 2

scala> object Counter { var n = 0 }
// defined object Counter

scala> Counter.n += 1
-- unsupported: assignment operator on a complex prefix
