scala> case class P(x: Int, y: Int)
// defined case class P

scala> P(1, 2)
val res0: P = P(x = 1, y = 2)

scala> case class Box(value: String)
// defined case class Box

scala> Box("hi")
val res1: Box = Box("hi")

scala> case class Named(name: String, tags: List[String], inner: P)
// defined case class Named

scala> Named("n", List("a", "b"), P(3, 4))
val res2: Named = Named(
  name = "n",
  tags = List("a", "b"),
  inner = P(x = 3, y = 4)
)

scala> Some(P(1, 2))
val res3: Some[P] = Some(P(x = 1, y = 2))

scala> None
val res4: None.type = None

scala> (1, "two", '3')
val res5: (Int, String, Char) = (1, "two", '3')

scala> ((1, 2), (3L, 4.5F))
val res6: ((Int, Int), (Long, Float)) = ((1, 2), (3L, 4.5F))

scala> Tuple1(1)
val res7: Tuple1[Int] = Tuple1(1)

scala> case class Shown(n: Int) { override def toString = s"Shown#$n" }
// defined case class Shown

scala> Shown(5)
val res8: Shown = Shown#5

scala> List(Shown(1), Shown(2))
val res9: List[Shown] = List(Shown#1, Shown#2)

scala> class Plain(val n: Int) { override def toString = "plain" }
// defined class Plain

scala> new Plain(1)
val res10: Plain = plain

scala> case object Obj
// defined case object Obj

scala> Obj
val res11: Obj.type = Obj

scala> case class `odd name`(`a b`: Int, c: Int)
// defined case class odd name

scala> `odd name`(1, 2)
