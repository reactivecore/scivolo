scala> case class <+>(l: Int, r: String)
// defined case class <+>

scala> <+>(1, "x")
val res13: <+> = 1 <+> "x"

scala> case class Wide(first: String, second: String, third: String, fourth: String)
// defined case class Wide

scala> Wide("aaaaaaaaaaaa", "bbbbbbbbbbbbbbb", "cccccccccccccccc", "dddddddddddddddd")
val res14: Wide = Wide(
  first = "aaaaaaaaaaaa",
  second = "bbbbbbbbbbbbbbb",
  third = "cccccccccccccccc",
  fourth = "dddddddddddddddd"
)

scala> List(Wide("aaaaaaaaaaaa", "bbbbbbbbbbbbbbb", "cccccccccccccccc", "dddddddddddddddd"), Wide("e", "f", "g", "h"))
val res15: List[Wide] = List(
  Wide(
    first = "aaaaaaaaaaaa",
    second = "bbbbbbbbbbbbbbb",
    third = "cccccccccccccccc",
    fourth = "dddddddddddddddd"
  ),
  Wide(first = "e", second = "f", third = "g", fourth = "h")
)

